{
  "name": "dsh-repomix",
  "version": "0.1.0",
  "description": "Bounded, read-only repository packing for DeepSeek Harness: XML or Markdown context with an explicit token estimate and truncation flag.",
  "type": "module",
  "bin": { "dsh-repomix": "bin/dsh-repomix.mjs" },
  "exports": {
    ".": "./plugin/index.js",
    "./pack": "./src/pack.mjs",
    "./plugin": "./plugin/index.js",
    "./icon": "./icon.svg"
  },
  "files": ["bin", "src", "plugin", "skills", "icon.svg", "README.md", "NOTICE.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./plugin/cordis.patch.yml" } },
  "engines": { "node": ">=20" },
  "keywords": ["dsh", "deepseek-harness", "repository", "context", "pack", "repomix"],
  "license": "MIT",
  "scripts": { "test": "node --test test/*.test.mjs" },
  "repository": { "type": "git", "url": "https://github.com/lengrufeng2008/dsh-repomix" }
}
